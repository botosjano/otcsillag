# Supabase (service role -- csak szerver-oldali API route-ok/cron használják, SOHA kliensre)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MVP-egyszerűsítés amíg nincs Identity/Org modul (l. lib/server/env.ts)
OTCSILLAG_DEFAULT_ORGANIZATION_ID=

# SMS -- FR-MSG-001, LINK/SeeMe (vezetői döntés). Hiányában NullSmsProvider fut (dev/teszt).
LINK_SEEME_API_KEY=
LINK_SEEME_WEBHOOK_SECRET=

# Email -- FR-MSG-002, MyLINK Email (vezetői döntés). Hiányában NullEmailProvider fut (dev/teszt).
MYLINK_EMAIL_API_KEY=
MYLINK_EMAIL_WEBHOOK_SECRET=

OTCSILLAG_BUSINESS_NAME=
OTCSILLAG_FROM_EMAIL=
OTCSILLAG_REPLY_TO_EMAIL=

# Publikus app URL a rövid linkekhez (/r/{token})
NEXT_PUBLIC_APP_URL=

# Cron endpoint védelme (POST /api/cron/dispatch, x-cron-secret header)
CRON_SECRET=
